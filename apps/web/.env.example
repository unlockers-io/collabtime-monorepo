# =============================================================================
# Collabtime Web App Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are required unless marked [OPTIONAL].
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Docker locally; Railway in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://collabtime:collabtime123@localhost:5433/collabtime
PGAPPNAME=collabtime:local:web

# -----------------------------------------------------------------------------
# Redis (Railway / self-hosted) [OPTIONAL at startup; required for team writes]
# -----------------------------------------------------------------------------
# Standard RESP-over-TCP. Accepts redis:// or rediss:// (TLS).
# Local dev: redis://localhost:6379
# Railway: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# SSE live updates default to enabled. Set false to retain 20-second polling.
LIVE_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32. The base URL is derived from the
# request via Better Auth's dynamic baseURL (allowedHosts); set
# AUTH_ALLOWED_HOSTS for prod/preview hosts beyond *.localhost.
BETTER_AUTH_SECRET=your-super-secret-key-here-minimum-32-chars

# [OPTIONAL] Extra hostnames Better Auth will accept as its dynamic base URL, as
# a comma-separated list. `**.localhost`, `localhost:*` and `127.0.0.1:*` are
# built in, and `collabtime.io`/`www.collabtime.io` are added in code, so local
# dev needs nothing here; set it for preview hosts such as `*.vercel.app`.
AUTH_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Trusted Origins [OPTIONAL]
# -----------------------------------------------------------------------------
# Optional: comma-separated browser origins Better Auth accepts for sign-in and
# other cookie-bearing requests. Falls back to
# `https://collabtime.web.localhost` when unset, so local dev needs nothing
# here. Setting it replaces that default rather than extending it, and a bare
# `*` entry is dropped.
CORS_ORIGINS=

# Optional: extra trusted origins, appended to the built-in loopback origins
# and to whatever CORS_ORIGINS resolved to. For origins that are not the
# browser app itself, such as a preview deployment or another service calling
# the auth routes. Local dev needs nothing here.
TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Web App URL [OPTIONAL]
# -----------------------------------------------------------------------------
# Used for absolute URLs in outbound email (invitation and notification links).
# Public metadata (robots, sitemap, canonical and Open Graph URLs) uses SITE_URL
# in src/lib/constants.ts instead.
WEB_APP_URL=https://collabtime.web.localhost

# -----------------------------------------------------------------------------
# Space Access Token Signing [OPTIONAL]
# -----------------------------------------------------------------------------
# Recommended: a dedicated secret for space access tokens (>=32 chars).
# Falls back to BETTER_AUTH_SECRET if unset, which couples the two secrets.
# SPACE_ACCESS_SECRET=your-space-access-secret-here

# -----------------------------------------------------------------------------
# Resend Email [OPTIONAL]
# -----------------------------------------------------------------------------
# Both must be set together to enable transactional email (welcome, password
# reset, sign-up attempt, invitations). Without them email is no-op and
# requireEmailVerification is disabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Sentry [OPTIONAL]
# -----------------------------------------------------------------------------
# The DSN is hardcoded in sentry.*.config.ts (a DSN is public by design), so
# only the build-time pieces live here. SENTRY_AUTH_TOKEN uploads source maps
# via withSentryConfig; `pnpm dev` runs fine without it. Set
# NEXT_PUBLIC_DISABLE_SENTRY=true to turn reporting off locally.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_DISABLE_SENTRY=

# Direct PostgreSQL connection [OPTIONAL locally; required for production db:deploy]
# Vercel production builds use this URL for prisma db push.
# DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database

# Transactional emails: invitation (14-day expiry), join-request-received,
# join-request-decided, invitation-decided, plus auth verification and recovery.
# Invitations are stored even when email delivery is unconfigured or fails.
