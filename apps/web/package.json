{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless run --name collabtime.web next dev --turbopack",
    "dev:ci": "next dev",
    "build": "next build",
    "vercel-build": "pnpm --filter @repo/db db:deploy && pnpm --filter @repo/db db:generate && next build",
    "start": "next start",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/social-image": "workspace:*",
    "@repo/transactional": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.5",
    "cn": "^0.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/portless-env": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
