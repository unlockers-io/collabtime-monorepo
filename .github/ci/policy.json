{
  "version": 1,
  "profile": "saas",
  "mode": "affected",
  "e2e": {
    "env": {
      "DATABASE_URL": "postgresql://test:test@localhost:5432/test",
      "PGAPPNAME": "collabtime:ci:e2e",
      "BETTER_AUTH_SECRET": "test-secret-minimum-32-characters-long-for-e2e",
      "EXPOSE_TESTING_API": "1",
      "WEB_APP_URL": "http://localhost:3000",
      "REDIS_URL": "redis://localhost:6379",
      "RESEND_FROM_EMAIL": "noreply@email.collabtime.io",
      "NEXT_PUBLIC_DISABLE_SENTRY": "true"
    },
    "services": {
      "postgres": {
        "image": "postgres:18-alpine",
        "env": {
          "POSTGRES_USER": "test",
          "POSTGRES_PASSWORD": "test",
          "POSTGRES_DB": "test"
        },
        "ports": ["5432:5432"],
        "options": "--health-cmd pg_isready --health-interval 1s --health-timeout 5s --health-retries 30"
      },
      "redis": {
        "image": "redis:8-alpine",
        "ports": ["6379:6379"],
        "options": "--health-cmd \"redis-cli ping\" --health-interval 1s --health-timeout 5s --health-retries 30"
      }
    },
    "setup": [
      {
        "run": "pnpm db:push"
      },
      {
        "name": "Verify team transactions and cutover",
        "env": {
          "MEMBERSHIP_POSTGRES_TESTS": "1"
        },
        "run": "node .github/ci/ci.mjs run e2e -- pnpm --filter @repo/web exec vitest run src/lib/membership.postgres.test.ts src/lib/team-postgres-repository.postgres.test.ts"
      },
      {
        "run": "pnpm build"
      },
      {
        "name": "Seed E2E test user",
        "run": "pnpm exec tsx tests/e2e/scripts/ensure-e2e-user.ts"
      }
    ]
  }
}
