{
  "name": "@repo/db",
  "files": [
    "dist/**",
    "src/**",
    "prisma/schema.prisma"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsdown",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:deploy": "if [ \"$VERCEL_ENV\" = \"production\" ]; then DATABASE_URL=\"$DIRECT_DATABASE_URL\" prisma db push; else echo \"db:deploy skipped (VERCEL_ENV=${VERCEL_ENV:-local})\"; fi",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "pnpm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "8.21.0",
    "prisma": "^7.9.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
